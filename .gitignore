# whitelist styled gitignore
*
!*/

# metadata and project setup file
!.gitignore
!pyproject.toml
!CLAUDE.md

# code
!*.py
!*.cpp
!*.sh

# deploy code
!*.html
!*.css
!*.js

# documentation
!report.md
!README.md

# project tour: teaching guide, design rationale, concept dependency graph
!educator.md
!design_rationale.md
!concept_list.md

# commonly ignored file type: binary data (*.pt, *.npz), training log (*.log, *.csv), internal/temporary documents (*.md).

# external Rapfi engine — not part of our repo (excluding the dir stops git
# from descending into it, so the whitelist re-includes above don't apply)
external-baseline/rapfi/

# onnxruntime-web binaries served same-origin — rebuild with
# deploy/web_app/fetch_vendor.sh (dir exclusion overrides the !*.js above)
deploy/web_app/vendor/
